{
  "compilerOptions": {
    "target": "ES2022",
    "useDefineForClassFields": true,
    "lib": ["DOM", "DOM.Iterable", "ES2022"],
    "allowJs": false,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "strict": true,
    "forceConsistentCasingInFileNames": true,
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "react-jsx"
  },
  "include": ["src", "tools"],
  // A one-off Survival proof of concept (results: docs/survival-poc-results.json).
  // It imports the private sibling checkout ../amath-bot-lab, which a clean
  // clone, CI and Vercel do not have, so it cannot be part of the app's build.
  "exclude": ["tools/survival-poc.ts"],
  "references": []
}
